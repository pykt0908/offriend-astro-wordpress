
# ============================================================
# OFFRIEND HEADLESS SECURITY — ซ่อน WordPress Frontend
# ============================================================
<IfModule mod_rewrite.c>
RewriteEngine On

# 1. อนุญาต REST API (pretty URL) → ส่งไป index.php ให้ WordPress จัดการ
RewriteRule ^wp-json(/.*)?$ index.php [L,NC]

# 2. อนุญาต REST API (plain URL) เช่น /?rest_route=/wp/v2
RewriteCond %{QUERY_STRING} rest_route= [NC]
RewriteRule ^ index.php [L]

# 3. อนุญาต wp-admin, wp-login, wp-content, wp-includes (ปล่อยผ่าน)
RewriteRule ^wp-admin(/.*)?$ - [L,NC]
RewriteRule ^wp-login\.php$ - [L,NC]
RewriteRule ^wp-cron\.php$ - [L,NC]
RewriteRule ^wp-content(/.*)?$ - [L,NC]
RewriteRule ^wp-includes(/.*)?$ - [L,NC]
RewriteRule ^index\.php$ - [L,NC]

# 4. ทุก URL อื่น → redirect ไปหน้าเว็บหลัก
RewriteRule ^(.*)$ https://offriend.net/ [R=302,L]

</IfModule>
# ============================================================



# BEGIN WordPress
# The directives (lines) between "BEGIN WordPress" and "END WordPress" are
# dynamically generated, and should only be modified via WordPress filters.
# Any changes to the directives between these markers will be overwritten.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>

# END WordPress