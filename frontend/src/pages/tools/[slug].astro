  <!-- Dynamic TOC Scrollspy Script -->
  <script is:inline>
    const setupTocScrollspy = () => {
      const links = document.querySelectorAll("#toc-nav .toc-link");
      if (links.length === 0) return;

      const items = [];
      links.forEach((link) => {
        const href = link.getAttribute("href");
        if (href && href.startsWith("#")) {
          const el = document.querySelector(href);
          if (el) {
            items.push({ el, link });
          }
        }
      });

      if (items.length === 0) return;

      const setActive = (activeLink) => {
        links.forEach((l) => {
          l.classList.remove(
            "text-[#060c2e]",
            "dark:text-[#38bdf8]",
            "border-[#060c2e]",
            "font-semibold",
          );
          l.classList.add(
            "text-slate-600",
            "dark:text-slate-400",
            "border-transparent",
          );
        });
        if (activeLink) {
          activeLink.classList.remove(
            "text-slate-600",
            "dark:text-slate-400",
            "border-transparent",
          );
          activeLink.classList.add(
            "text-[#060c2e]",
            "dark:text-[#38bdf8]",
            "border-[#060c2e]",
            "font-semibold",
          );
        }
      };

      const handleScroll = () => {
        const scrollPosition = window.scrollY + 140;
        let currentItem = items[0];

        for (const item of items) {
          const top = item.el.getBoundingClientRect().top + window.scrollY;
          if (top <= scrollPosition) {
            currentItem = item;
          }
        }

        if (currentItem) {
          setActive(currentItem.link);
        }
      };

      window.addEventListener("scroll", handleScroll, { passive: true });
      handleScroll();
    };

    document.addEventListener("DOMContentLoaded", setupTocScrollspy);
    document.addEventListener("astro:page-load", setupTocScrollspy);
  </script>
