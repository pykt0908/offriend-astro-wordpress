---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { getPosts, getPostBySlug } from "../../lib/wordpress";
import { imageProps } from "../../lib/image";
import type { WPPost } from "../../types/wordpress";
import { Calendar, Copy, Share2, Clock, BookOpen } from "lucide-react";

export const prerender = false;

interface Props {
  post?: WPPost;
}

const { slug } = Astro.params;
if (!slug) {
  return new Response(null, { status: 404, statusText: "Not found" });
}

const post = await getPostBySlug(slug);

if (!post) {
  return new Response(null, { status: 404, statusText: "Post Not Found" });
}

// Fetch posts for recent and related posts
const allPosts = await getPosts({ perPage: 16 });
const otherPosts = allPosts.filter((p) => p.slug !== slug && p.id !== post.id);

// 1. Related Posts (filter by same category, fallback to others)
const postCategoryIds = post.categories || [];
const matchedRelated = otherPosts.filter((p) =>
  p.categories?.some((c) => postCategoryIds.includes(c))
);
const relatedPosts = (matchedRelated.length > 0 ? matchedRelated : otherPosts).slice(0, 3);

// 2. Recent Posts (latest excluding current)
const recentPosts = otherPosts.slice(0, 5);

const featuredMedia = post._embedded?.["wp:featuredmedia"]?.[0];
const featuredImage = post.featured_image_url || featuredMedia?.source_url || null;
const featuredPicture = featuredImage
  ? imageProps(featuredImage, featuredMedia, { width: 1280, height: 720 }, {
      widths: [640, 960, 1280],
      sizes: '(min-width: 768px) 720px, 100vw',
    })
  : null;

const categories = post._embedded?.["wp:term"]?.[0]?.map((t) => t.name) || [];
const categoryName = categories[0] || "บทความทั่วไป";

const authorName = post._embedded?.author?.[0]?.name || "Offriend Editorial";

// Short Thai Date matching reference: "1 ต.ค. 2569"
const formattedDate = new Date(post.date || Date.now()).toLocaleDateString(
  "th-TH",
  {
    year: "numeric",
    month: "short",
    day: "numeric",
  },
);

const pageTitle = `${post.title.rendered.replace(/<[^>]+>/g, "")} — Offriend`;
const cleanDescription = (
  post.excerpt?.rendered ||
  post.content?.rendered ||
  ""
)
  .replace(/<[^>]+>/g, "")
  .trim()
  .slice(0, 220);

const pageUrl = Astro.url.href;
---

<BaseLayout
  title={pageTitle}
  description={cleanDescription}
  image={featuredImage || undefined}
>
  <div class="py-8 sm:py-12 bg-white dark:bg-[#070b14] transition-colors">
    <div class="max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- 2-COLUMN EDITORIAL LAYOUT (Main Article + Right Sticky Sidebar) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
        <!-- LEFT COLUMN: MAIN ARTICLE (8 Cols) -->
        <main class="lg:col-span-8 space-y-4">
          <!-- 1. Breadcrumbs: หน้าแรก / บทความ / บทความทั่วไป -->
          <nav
            aria-label="Breadcrumb"
            class="flex flex-wrap items-center gap-1.5 text-xs text-slate-500 dark:text-slate-400 font-content mb-3"
          >
            <a
              href="/"
              data-astro-prefetch="hover"
              class="hover:text-[#060c2e] dark:hover:text-[#38bdf8] transition-colors"
              >หน้าแรก</a
            >
            <span class="text-slate-300 dark:text-slate-600">/</span>
            <a
              href="/blog"
              data-astro-prefetch="hover"
              class="hover:text-[#060c2e] dark:hover:text-[#38bdf8] transition-colors"
              >บทความ</a
            >
            <span class="text-slate-300 dark:text-slate-600">/</span>
            <span class="text-slate-700 dark:text-slate-300 font-medium"
              >{categoryName}</span
            >
          </nav>

          <!-- 2. Category Tag -->
          <div>
            <span
              class="text-xs sm:text-sm font-bold text-red-700 dark:text-red-400 tracking-wide uppercase"
            >
              {categoryName}
            </span>
          </div>

          <!-- 3. Big Bold Article Title -->
          <h1
            class="text-2xl sm:text-3xl lg:text-4xl xl:text-[40px] font-extrabold text-slate-900 dark:text-white font-display leading-[1.25] tracking-tight"
            set:html={post.title.rendered}
          />

          <!-- 4. Date with Calendar Icon (e.g. 1 ต.ค. 2569) -->
          <div
            class="flex items-center gap-1.5 text-xs text-slate-500 dark:text-slate-400 font-content pt-1"
          >
            <Calendar
              className="w-3.5 h-3.5 text-slate-400 dark:text-slate-500"
            />
            <span>{formattedDate}</span>
          </div>

          <!-- 5. Social Share Row (Facebook, Line, X, Copy Link, Share) -->
          <div
            class="flex flex-wrap items-center gap-2 pt-3 pb-6 border-b border-slate-100 dark:border-white/5"
          >
            <!-- Facebook -->
            <a
              href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageUrl)}`}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="แชร์ไปยัง Facebook"
              title="แชร์ไปยัง Facebook"
              class="w-8 h-8 rounded-full border border-slate-200 dark:border-white/10 bg-white dark:bg-white/5 hover:bg-slate-50 dark:hover:bg-white/10 flex items-center justify-center transition-transform hover:scale-105 shadow-2xs"
            >
              <svg class="w-4 h-4 fill-[#1877f2]" viewBox="0 0 24 24">
                <path
                  d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
                ></path>
              </svg>
            </a>

            <!-- Line -->
            <a
              href={`https://social-plugins.line.me/lineit/share?url=${encodeURIComponent(pageUrl)}`}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="แชร์ไปยัง LINE"
              title="แชร์ไปยัง LINE"
              class="w-8 h-8 rounded-full border border-slate-200 dark:border-white/10 bg-white dark:bg-white/5 hover:bg-slate-50 dark:hover:bg-white/10 flex items-center justify-center transition-transform hover:scale-105 shadow-2xs"
            >
              <svg class="w-4 h-4 fill-[#047a3a]" viewBox="0 0 24 24">
                <path
                  d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.346 0 .627.285.627.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63.349 0 .631.285.631.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.282.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"
                ></path>
              </svg>
            </a>

            <!-- X / Twitter -->
            <a
              href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(pageUrl)}&text=${encodeURIComponent(pageTitle)}`}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="แชร์ไปยัง X"
              title="แชร์ไปยัง X"
              class="w-8 h-8 rounded-full border border-slate-200 dark:border-white/10 bg-white dark:bg-white/5 hover:bg-slate-50 dark:hover:bg-white/10 flex items-center justify-center transition-transform hover:scale-105 shadow-2xs text-slate-800 dark:text-white"
            >
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                <path
                  d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                ></path>
              </svg>
            </a>

            <!-- Copy Link Button -->
            <button
              type="button"
              id="copy-article-btn"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-white/10 bg-white dark:bg-white/5 hover:bg-slate-50 dark:hover:bg-white/10 transition-colors cursor-pointer shadow-2xs"
            >
              <Copy
                className="w-3.5 h-3.5 text-slate-500 dark:text-slate-400"
              />
              <span id="copy-btn-text">คัดลอกลิงก์</span>
            </button>

            <!-- Native Share Button -->
            <button
              type="button"
              id="native-share-btn"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-white/10 bg-white dark:bg-white/5 hover:bg-slate-50 dark:hover:bg-white/10 transition-colors cursor-pointer shadow-2xs"
            >
              <Share2
                className="w-3.5 h-3.5 text-slate-500 dark:text-slate-400"
              />
              <span>แชร์</span>
            </button>
          </div>

          <!-- 6. Lead Excerpt with Left Vertical Accent Border (Brand Sky Blue Line) -->
          <!-- {cleanDescription && (
            <div class="pl-4 sm:pl-5 border-l-4 border-[#162d59] dark:border-indigo-300 py-1 my-6">
              <p class="text-sm sm:text-base font-semibold text-slate-800 dark:text-slate-200 leading-relaxed font-content">
                {cleanDescription}
              </p>
            </div>
          )} -->

          <!-- 7. Featured Image -->
          {
            featuredPicture && (
              <div class="w-full rounded-xl overflow-hidden border border-slate-200 dark:border-white/10 my-6 shadow-md">
                <img
                  {...featuredPicture}
                  alt={post.title.rendered}
                  class="w-full h-auto object-cover max-h-[520px] rounded-xl"
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                />
              </div>
            )
          }

          <!-- 8. Content Prose -->
          <article
            class="prose prose-slate dark:prose-invert max-w-none text-slate-800 dark:text-slate-200 leading-relaxed font-content pt-2 pb-8"
          >
            <div set:html={post.content.rendered} />
          </article>

          <!-- 9. Related Articles Section (บทความที่เกี่ยวข้อง) -->
          {relatedPosts.length > 0 && (
            <section class="pt-10 mt-12 border-t border-slate-200 dark:border-white/10 space-y-6">
              <div class="flex items-center justify-between">
                <div>
                  <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
                    <span class="w-2.5 h-6 bg-[#162d59] dark:bg-[#38bdf8] rounded-full"></span>
                    <span>บทความที่เกี่ยวข้อง</span>
                  </h2>
                  <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
                    เรื่องที่คุณอาจสนใจเพิ่มเติม
                  </p>
                </div>
                <a
                  href="/blog"
                  class="text-xs sm:text-sm font-bold text-[#162d59] dark:text-[#38bdf8] hover:underline whitespace-nowrap"
                >
                  ดูบทความทั้งหมด →
                </a>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
                {relatedPosts.map((rPost) => (
                  <PostCard post={rPost} />
                ))}
              </div>
            </section>
          )}
        </main>

        <!-- RIGHT COLUMN: STICKY SIDEBAR (4 Cols - บทความล่าสุด & บทความที่เกี่ยวข้อง) -->
        <aside class="lg:col-span-4">
          <div class="lg:sticky lg:top-28 space-y-6">
            <!-- Box 1: บทความล่าสุด (Sticky) -->
            <div
              class="bg-white dark:bg-[#0c1222] border border-slate-200 dark:border-white/10 rounded-2xl p-5 sm:p-6 shadow-xs"
            >
              <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-white/10 mb-4">
                <h3
                  class="text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-300 font-display flex items-center gap-1.5"
                >
                  <Clock className="w-3.5 h-3.5 text-[#162d59] dark:text-[#38bdf8]" />
                  <span>บทความล่าสุด</span>
                </h3>
              </div>

              {
                recentPosts.length > 0 ? (
                  <div class="space-y-4">
                    {recentPosts.map((rPost) => {
                      const rDate = new Date(
                        rPost.date || Date.now(),
                      ).toLocaleDateString("th-TH", {
                        year: "numeric",
                        month: "short",
                        day: "numeric",
                      });
                      return (
                        <div class="border-b border-slate-100 dark:border-white/5 pb-3.5 last:border-b-0 last:pb-0 group">
                          <a
                            href={`/blog/${rPost.slug}`}
                            data-astro-prefetch="hover"
                            class="font-bold text-sm text-slate-900 dark:text-white group-hover:text-[#162d59] dark:group-hover:text-[#38bdf8] transition-colors line-clamp-2 leading-snug block mb-1"
                            set:html={rPost.title.rendered}
                          />
                          <span class="text-xs text-slate-600 dark:text-slate-300 font-content block">
                            {rDate}
                          </span>
                        </div>
                      );
                    })}
                  </div>
                ) : (
                  <p class="text-xs text-slate-400">ยังไม่มีบทความอื่นๆ</p>
                )
              }
            </div>

            <!-- Box 2: บทความที่เกี่ยวข้อง (Sidebar Quick List) -->
            {relatedPosts.length > 0 && (
              <div
                class="bg-white dark:bg-[#0c1222] border border-slate-200 dark:border-white/10 rounded-2xl p-5 sm:p-6 shadow-xs"
              >
                <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-white/10 mb-4">
                  <h3
                    class="text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-300 font-display flex items-center gap-1.5"
                  >
                    <BookOpen className="w-3.5 h-3.5 text-[#162d59] dark:text-[#38bdf8]" />
                    <span>บทความที่เกี่ยวข้อง</span>
                  </h3>
                </div>

                <div class="space-y-3.5">
                  {relatedPosts.map((relPost) => {
                    const relDate = new Date(
                      relPost.date || Date.now(),
                    ).toLocaleDateString("th-TH", {
                      year: "numeric",
                      month: "short",
                      day: "numeric",
                    });
                    const relCat =
                      relPost._embedded?.["wp:term"]?.[0]?.[0]?.name || "บทความ";

                    return (
                      <a
                        href={`/blog/${relPost.slug}`}
                        data-astro-prefetch="hover"
                        class="block group p-2.5 rounded-xl hover:bg-slate-50 dark:hover:bg-white/5 transition-colors border border-transparent hover:border-slate-200/80 dark:hover:border-white/5"
                      >
                        <span class="inline-block text-[10px] font-bold text-[#162d59] dark:text-[#38bdf8] uppercase mb-1">
                          {relCat}
                        </span>
                        <h4
                          class="text-xs sm:text-sm font-bold text-slate-800 dark:text-slate-200 group-hover:text-[#162d59] dark:group-hover:text-[#38bdf8] line-clamp-2 leading-snug transition-colors"
                          set:html={relPost.title.rendered}
                        />
                        <span class="text-xs text-slate-600 dark:text-slate-300 mt-1 block font-content">
                          {relDate}
                        </span>
                      </a>
                    );
                  })}
                </div>
              </div>
            )}
          </div>
        </aside>
      </div>
    </div>
  </div>

  <!-- Client-side script for Copy Link & Native Share -->
  <script is:inline>
    const setupArticleActions = () => {
      const copyBtn = document.getElementById("copy-article-btn");
      const copyText = document.getElementById("copy-btn-text");
      const shareBtn = document.getElementById("native-share-btn");

      copyBtn?.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          if (copyText) {
            const original = copyText.textContent;
            copyText.textContent = "คัดลอกแล้ว!";
            setTimeout(() => {
              copyText.textContent = original;
            }, 2000);
          }
        } catch (err) {
          console.error("Clipboard copy failed:", err);
        }
      });

      shareBtn?.addEventListener("click", async () => {
        if (navigator.share) {
          try {
            await navigator.share({
              title: document.title,
              url: window.location.href,
            });
          } catch (err) {
            // User cancelled share
          }
        } else {
          copyBtn?.click();
        }
      });
    };

    setupArticleActions();
    document.addEventListener("astro:page-load", setupArticleActions);
  </script>
</BaseLayout>
