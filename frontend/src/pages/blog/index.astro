---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import PostCard from "../../components/PostCard.astro";
import { getPosts, getCategories } from "../../lib/wordpress";
import { FileText } from "lucide-react";

export const prerender = false;

const posts = await getPosts({ perPage: 12 });
const categories = await getCategories();
---

<BaseLayout
  title="ข่าวสารและบทความเทคโนโลยี — Offriend Insights"
  description="รวมบทความ ข่าวสาร และองค์ความรู้ด้านการพัฒนาซอฟต์แวร์ คลาวด์ และ Headless CMS โดยทีมงาน Offriend"
>
  <PageHeader
    breadcrumbs={[{ label: "หน้าแรก", href: "/" }, { label: "บทความ" }]}
    kicker="ARTICLES & TECH INSIGHTS"
    title="คลังบทความและ"
    titleGradient="ความรู้ด้านเทคโนโลยี"
    description="คลังความรู้และบทความที่น่าสนใจที่เราคัดสรรมาให้คุณ"
  >
    {
      categories.length > 0 && (
        <div class="flex items-center gap-2 mt-6 flex-wrap">
          <span class="text-xs font-bold text-[#93c5fd]/80 uppercase tracking-wider mr-1">
            หมวดหมู่:
          </span>
          <a
            href="/blog"
            class="px-3.5 py-1.5 rounded-lg text-xs font-bold bg-[#162d59]/20 text-[#93c5fd] border border-[#162d59]/40 hover:bg-[#162d59]/30 transition-colors"
          >
            ทั้งหมด
          </a>
          {categories.map((cat) => (
            <span class="px-3.5 py-1.5 rounded-lg text-xs font-medium bg-white/10 text-slate-200 border border-white/10 hover:border-indigo-300/40 hover:text-white cursor-pointer transition-colors">
              {cat.name} ({cat.count})
            </span>
          ))}
        </div>
      )
    }
  </PageHeader>

  <!-- Posts Grid -->
  <section class="py-20 transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      {
        posts.length === 0 ? (
          <div class="glass-panel p-12 text-center max-w-lg mx-auto rounded-xl">
            <div class="w-14 h-14 rounded-xl bg-[#162d59]/15 border border-[#162d59]/25 flex items-center justify-center text-[#060c2e] dark:text-[#38bdf8] mx-auto mb-4">
              <FileText className="w-7 h-7" />
            </div>
            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">
              ยังไม่มีบทความในระบบ
            </h3>
            <p class="text-slate-700 dark:text-slate-300 text-sm mb-6 font-normal">
              เข้าสู่ระบบ WordPress เพื่อเริ่มเขียนบทความแรกของคุณ
            </p>
            <a
              href="http://localhost/offriend-backend/wp-admin/post-new.php"
              target="_blank"
              class="btn-brand-primary text-xs"
            >
              สร้างบทความใน WordPress ↗
            </a>
          </div>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {posts.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
