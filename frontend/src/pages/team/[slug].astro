---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTeamMemberBySlug } from '../../lib/wordpress';
import { imageProps } from '../../lib/image';
import { FileText, ArrowLeft, Briefcase, GraduationCap } from 'lucide-react';

export const prerender = false;

const { slug } = Astro.params;
const member = await getTeamMemberBySlug(slug as string);


if (!member) {
  return Astro.redirect('/team');
}

const displayName = member.prefix ? `${member.prefix} ${member.name}` : member.name;
const pageTitle = `${displayName} (${member.nameEn}) — ${member.role} | Offriend`;
---

<BaseLayout
  title={pageTitle}
  description={`${displayName} - ${member.role} ที่ Offriend`}
  image={member.avatar}
>
  <div class="py-10 sm:py-16 bg-white dark:bg-[#070b14] transition-colors">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8 sm:space-y-10">
      
      <!-- Breadcrumbs -->
      <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-xs sm:text-sm text-slate-500 dark:text-slate-400">
        <a href="/" class="hover:text-[#162d59] dark:hover:text-[#38bdf8] transition-colors">หน้าแรก</a>
        <span class="text-slate-300 dark:text-slate-600">/</span>
        <a href="/team" class="hover:text-[#162d59] dark:hover:text-[#38bdf8] transition-colors">บุคลากร</a>
        <span class="text-slate-300 dark:text-slate-600">/</span>
        <span class="text-slate-800 dark:text-slate-200 font-bold">{member.name}</span>
      </nav>

      <!-- Profile Header Card (Offriend Brand Theme: Deep Teal & Sky Blue Accents) -->
      <div class="relative overflow-hidden p-6 sm:p-8 rounded-3xl bg-slate-50/80 dark:bg-[#0c1222] border border-slate-200/80 dark:border-white/10 shadow-xs">
        <!-- Subtle Brand Ambient Glow -->
        <div class="absolute -top-12 -right-12 w-48 h-48 bg-[#38bdf8]/10 dark:bg-[#38bdf8]/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative flex flex-col sm:flex-row items-center sm:items-start gap-6 sm:gap-8">
          <!-- Circular Avatar with Brand Ring -->
          <div class="relative shrink-0">
            <img
              {...imageProps(member.avatar, null, { width: 512, height: 512 })}
              alt={member.name}
              class="w-28 h-28 sm:w-32 sm:h-32 rounded-full object-cover ring-4 ring-[#38bdf8]/20 dark:ring-[#38bdf8]/30 shadow-md"
              loading="eager"
              decoding="async"
            />
          </div>

          <!-- Info Column -->
          <div class="text-center sm:text-left space-y-2 flex-grow">
            <!-- Role with Offriend Coral Accent Dash -->
            <div class="flex items-center justify-center sm:justify-start gap-2 text-xs sm:text-sm font-bold text-[#162d59] dark:text-[#38bdf8]">
              <span class="w-4 h-[2.5px] bg-[#e8624f] rounded-full"></span>
              <span>{member.role}</span>
            </div>

            <!-- Thai Name -->
            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 dark:text-white leading-tight font-display">
              {displayName}
            </h1>

            <!-- English Name -->
            <p class="text-base sm:text-lg font-bold text-slate-700 dark:text-slate-300">
              {member.nameEn}
            </p>

            <!-- Education Line -->
            {member.educationLine && (
              <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 leading-relaxed pt-0.5">
                {member.educationLine}
              </p>
            )}

            <!-- Action Button: File Resume PDF with Offriend Signature Colors -->
            <div class="pt-3">
              <a
                href={member.resumePdf || '#'}
                target={member.resumePdf && member.resumePdf !== '#' ? '_blank' : undefined}
                rel={member.resumePdf && member.resumePdf !== '#' ? 'noopener noreferrer' : undefined}
                class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-[#162d59] hover:bg-[#0a192f] dark:bg-[#38bdf8] dark:hover:bg-[#0284c7] text-white dark:text-slate-950 shadow-xs hover:shadow transition-all duration-200 cursor-pointer"
              >
                <FileText className="w-4 h-4 text-white dark:text-slate-950" />
                <span>ไฟล์ประวัติ (PDF)</span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Detail Content Sections (Clean white card with Offriend branding) -->
      <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-[#0c1222] border border-slate-200/80 dark:border-white/10 shadow-xs space-y-8 sm:space-y-10">
        
        <!-- Section: จุดมุ่งหมายในการทำงาน -->
        {member.objective && (
          <div class="space-y-3">
            <div class="flex items-center text-lg sm:text-xl font-bold text-slate-900 dark:text-white border-l-4 border-[#162d59] dark:border-[#38bdf8] pl-3.5 leading-none font-display">
              จุดมุ่งหมายในการทำงาน
            </div>
            <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed pl-4">
              {member.objective}
            </p>
          </div>
        )}

        <!-- Section: ประสบการณ์ทำงาน -->
        {member.experiences && member.experiences.length > 0 && (
          <div class="space-y-4">
            <div class="flex items-center text-lg sm:text-xl font-bold text-slate-900 dark:text-white border-l-4 border-[#162d59] dark:border-[#38bdf8] pl-3.5 leading-none font-display">
              ประสบการณ์ทำงาน
            </div>
            <ul class="space-y-3.5 text-sm sm:text-base text-slate-700 dark:text-slate-300 leading-relaxed pl-4">
              {member.experiences.map((exp) => (
                <li class="flex items-start gap-3">
                  <span class="w-2 h-2 rounded-full bg-[#162d59] dark:bg-[#38bdf8] mt-2 shrink-0"></span>
                  <span>{exp}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

      </div>

      <!-- Bottom Nav: Back to Team List -->
      <div class="pt-4">
        <a
          href="/team"
          class="inline-flex items-center gap-2 text-xs sm:text-sm font-bold text-slate-500 hover:text-[#162d59] dark:hover:text-[#38bdf8] transition-colors group"
        >
          <ArrowLeft className="w-4 h-4 transition-transform group-hover:-translate-x-1" />
          <span>กลับสู่หน้าบุคลากรทั้งหมด</span>
        </a>
      </div>

    </div>
  </div>
</BaseLayout>
