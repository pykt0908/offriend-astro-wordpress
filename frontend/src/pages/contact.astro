---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { getSiteSettings } from "../lib/wordpress";
import {
  Phone,
  Mail,
  Clock,
  ArrowRight,
  ArrowUpRight,
  MapPin,
} from "lucide-react";

export const prerender = false;

const siteSettings = await getSiteSettings();
const cleanPhone = siteSettings.phone.replace(/[^0-9]/g, "");
---

<BaseLayout
  title="ติดต่อเรา — ช่องทางติดต่อและนัดหมายปรึกษา"
  description={`ติดต่อทีมงาน ${siteSettings.company_name_th} เพื่อสอบถามบริการ พัฒนาโปรเจกต์ หรือขอรับคำปรึกษาด้านเทคโนโลยี โทร ${siteSettings.phone} หรือ LINE: ${siteSettings.line_id}`}
>
  <PageHeader
    breadcrumbs={[{ label: "หน้าแรก", href: "/" }, { label: "ติดต่อเรา" }]}
    kicker="GET IN TOUCH"
    title="ติดต่อเรา"
    titleGradient="ช่องทางติดต่อและขอคำปรึกษา"
    description="ทีมงานพร้อมรับฟัง ให้คำแนะนำ และร่วมสร้างสรรค์โซลูชันดิจิทัลที่ตอบโจทย์ความสำเร็จขององค์กรคุณ"
  />

  <!-- Reference Layout Section: ช่องทางติดต่อ -->
  <section
    class="py-12 sm:py-16 bg-slate-50/80 dark:bg-[#070b14] transition-colors duration-300"
  >
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col space-y-6">
        <h2
          class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight"
        >
          ช่องทางติดต่อ
        </h2>

        <!-- 2-Column Contact Cards Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Card 1: มือถือ / เบอร์โทร (Emerald Phone) -->
          <a
            href={`tel:${cleanPhone}`}
            class="group p-4 sm:p-5 rounded-2xl bg-white dark:bg-[#0c1222] border border-slate-200/90 dark:border-white/10 hover:border-emerald-500/50 hover:shadow-md hover:shadow-emerald-500/5 transition-all flex items-center justify-between"
          >
            <div class="flex items-center gap-3.5">
              <div
                class="w-12 h-12 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-400 border border-emerald-200/80 dark:border-emerald-500/30 flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform"
              >
                <Phone className="w-5 h-5" />
              </div>
              <div>
                <span
                  class="block text-xs font-semibold text-slate-500 dark:text-slate-400"
                  >โทร / มือถือ</span
                >
                <span
                  class="block text-base font-bold text-slate-900 dark:text-white group-hover:text-emerald-700 dark:group-hover:text-emerald-400 transition-colors"
                >
                  {siteSettings.phone}
                </span>
              </div>
            </div>
            <ArrowRight
              className="w-4 h-4 text-slate-600 dark:text-slate-300 group-hover:text-emerald-700 dark:group-hover:text-emerald-400 group-hover:translate-x-0.5 transition-all flex-shrink-0"
            />
          </a>

          <!-- Card 2: อีเมล (Royal Blue Mail) -->
          <a
            href={`mailto:${siteSettings.contact_email}`}
            class="group p-4 sm:p-5 rounded-2xl bg-white dark:bg-[#0c1222] border border-slate-200/90 dark:border-white/10 hover:border-blue-500/50 hover:shadow-md hover:shadow-blue-500/5 transition-all flex items-center justify-between"
          >
            <div class="flex items-center gap-3.5">
              <div
                class="w-12 h-12 rounded-xl bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 border border-blue-200/80 dark:border-blue-500/30 flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform"
              >
                <Mail className="w-5 h-5" />
              </div>
              <div class="min-w-0">
                <span
                  class="block text-xs font-semibold text-slate-500 dark:text-slate-400"
                  >อีเมลติดต่อ</span
                >
                <span
                  class="block text-base font-bold text-slate-900 dark:text-white truncate group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors"
                >
                  {siteSettings.contact_email}
                </span>
              </div>
            </div>
            <ArrowRight
              className="w-4 h-4 text-slate-600 dark:text-slate-300 group-hover:text-blue-600 dark:group-hover:text-blue-400 group-hover:translate-x-0.5 transition-all flex-shrink-0"
            />
          </a>

          <!-- Card 3: LINE (Official LINE Green) -->
          <a
            href={siteSettings.line_url}
            target="_blank"
            rel="noopener noreferrer"
            class="group p-4 sm:p-5 rounded-2xl bg-white dark:bg-[#0c1222] border border-slate-200/90 dark:border-white/10 hover:border-[#06c755]/50 hover:shadow-md hover:shadow-[#06c755]/5 transition-all flex items-center justify-between"
          >
            <div class="flex items-center gap-3.5">
              <div
                class="w-12 h-12 rounded-xl bg-[#047a3a]/10 dark:bg-[#047a3a]/20 text-[#047a3a] dark:text-[#4ade80] border border-[#047a3a]/30 flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform"
              >
                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                  <path
                    d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.346 0 .627.285.627.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63.349 0 .631.285.631.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.282.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"
                  ></path>
                </svg>
              </div>
              <div>
                <span
                  class="block text-xs font-semibold text-slate-500 dark:text-slate-400"
                  >LINE Official</span
                >
                <span
                  class="block text-base font-bold text-slate-900 dark:text-white group-hover:text-[#047a3a] transition-colors"
                >
                  {siteSettings.line_id}
                </span>
              </div>
            </div>
            <ArrowUpRight
              className="w-4 h-4 text-slate-600 dark:text-slate-300 group-hover:text-[#047a3a] group-hover:-translate-y-0.5 group-hover:translate-x-0.5 transition-all flex-shrink-0"
            />
          </a>

          <!-- Card 4: FACEBOOK (Official Facebook Blue) -->
          <a
            href={siteSettings.facebook_url}
            target="_blank"
            rel="noopener noreferrer"
            class="group p-4 sm:p-5 rounded-2xl bg-white dark:bg-[#0c1222] border border-slate-200/90 dark:border-white/10 hover:border-[#1877f2]/50 hover:shadow-md hover:shadow-[#1877f2]/5 transition-all flex items-center justify-between"
          >
            <div class="flex items-center gap-3.5">
              <div
                class="w-12 h-12 rounded-xl bg-[#1877f2]/10 dark:bg-[#1877f2]/20 text-[#1877f2] border border-[#1877f2]/30 flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform"
              >
                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                  <path
                    d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
                  ></path>
                </svg>
              </div>
              <div>
                <span
                  class="block text-xs font-semibold text-slate-500 dark:text-slate-400"
                  >Facebook Page</span
                >
                <span
                  class="block text-base font-bold text-slate-900 dark:text-white group-hover:text-[#1877f2] transition-colors"
                >
                  Offriend Official
                </span>
              </div>
            </div>
            <ArrowUpRight
              className="w-4 h-4 text-slate-400 group-hover:text-[#1877f2] group-hover:-translate-y-0.5 group-hover:translate-x-0.5 transition-all flex-shrink-0"
            />
          </a>
        </div>

        <!-- Card 5: ที่อยู่สำนักงานใหญ่ (Rose Location Pin) -->
        <div
          class="p-5 sm:p-6 rounded-2xl bg-white dark:bg-[#0c1222] border border-slate-200/90 dark:border-white/10 shadow-xs flex items-start gap-4"
        >
          <div
            class="w-12 h-12 rounded-xl bg-rose-50 dark:bg-rose-950/40 text-rose-500 dark:text-rose-400 border border-rose-200/80 dark:border-rose-500/30 flex items-center justify-center flex-shrink-0 mt-0.5"
          >
            <MapPin className="w-5 h-5" />
          </div>
          <div>
            <span
              class="block text-xs font-semibold text-slate-500 dark:text-slate-400"
              >ที่อยู่</span
            >
            <span
              class="block text-base font-bold text-slate-900 dark:text-white mt-0.5"
            >
              {siteSettings.company_name_th} ({siteSettings.company_name_en})
            </span>
            <p
              class="text-sm text-slate-600 dark:text-slate-300 mt-1.5 leading-relaxed font-normal"
            >
              {siteSettings.headquarters_address}
            </p>
          </div>
        </div>

        <!-- Card 6: เวลาทำการ (Amber Clock) -->
        <div
          class="p-5 sm:p-6 rounded-2xl bg-white dark:bg-[#0c1222] border border-slate-200/90 dark:border-white/10 shadow-xs flex items-start gap-4"
        >
          <div
            class="w-12 h-12 rounded-xl bg-amber-50 dark:bg-amber-950/40 text-amber-600 dark:text-amber-400 border border-amber-200/80 dark:border-amber-500/30 flex items-center justify-center flex-shrink-0 mt-0.5"
          >
            <Clock className="w-5 h-5" />
          </div>
          <div>
            <span
              class="block text-xs font-semibold text-slate-500 dark:text-slate-400"
              >เวลาทำการ</span
            >
            <span
              class="block text-base sm:text-lg font-bold text-slate-900 dark:text-white mt-0.5"
            >
              {siteSettings.working_hours}
            </span>
            <p
              class="text-sm text-slate-500 dark:text-slate-400 mt-2 font-normal"
            >
              นอกเวลาทำการ ท่านสามารถทัก LINE หรือส่งอีเมลไว้ได้ตลอด 24 ชั่วโมง
              ทีมงานจะติดต่อกลับในวันทำการถัดไป
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
