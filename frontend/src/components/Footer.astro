---
import { MapPin, Mail, Phone, Clock } from "lucide-react";
import { getSiteSettings, getServicesFromWP } from "../lib/wordpress";
import { imageProps } from "../lib/image";

const currentYear = new Date().getFullYear();
const [siteSettings, wpServices] = await Promise.all([
  getSiteSettings(),
  getServicesFromWP(),
]);
const footerLogo = imageProps("/images/logos/no-bg/1.5TP.webp", null, { width: 240, height: 168 });
---

<footer
  class="mt-auto border-t border-slate-200 dark:border-white/10 bg-slate-900 text-slate-300 dark:bg-[#040711] relative overflow-hidden transition-colors duration-300"
>
  <!-- Subtle Ambient Glow -->
  <div
    class="absolute top-0 left-1/4 -translate-x-1/2 w-96 h-48 bg-[#162d59]/20 blur-[120px] pointer-events-none"
  >
  </div>
  <div
    class="absolute bottom-0 right-1/4 w-96 h-48 bg-[#38bdf8]/10 blur-[120px] pointer-events-none"
  >
  </div>

  <!-- Main Footer Content -->
  <div class="max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-12">
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-12 mb-16"
    >
      <!-- Col 1: Corporate Identity & Registration (4 cols on lg) -->
      <div class="lg:col-span-4 space-y-5">
        <a
          href="/"
          class="flex items-center gap-3 focus:outline-none select-none"
        >
          <img
            {...footerLogo}
            alt={siteSettings.company_name_th}
            class="h-10 w-auto object-contain drop-shadow-[0_0_12px_rgba(41,168,216,0.3)]"
            loading="lazy"
            decoding="async"
          />
          <div class="flex flex-col justify-center">
            <span
              class="text-xl font-black tracking-tight text-white leading-tight"
            >
              {siteSettings.company_name_th}
            </span>
            <span
              class="text-[11px] font-semibold text-[#38bdf8] tracking-wider uppercase mt-0.5"
            >
              {siteSettings.company_name_en}
            </span>
          </div>
        </a>

        <p
          class="text-slate-300 text-xs sm:text-sm leading-relaxed font-normal"
        >
          {siteSettings.company_desc}
        </p>

        <!-- LINE Official Contact Pill -->
        <div class="pt-1">
          <a
            href={siteSettings.line_url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-lg text-xs font-bold bg-[#047a3a] hover:bg-[#036530] text-white shadow-xs transition-colors"
          >
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path
                d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.346 0 .627.285.627.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63.349 0 .631.285.631.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.282.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"
              ></path>
            </svg>
            <span>LINE Official: {siteSettings.line_id}</span>
          </a>
        </div>
      </div>

      <!-- Col 2: Services & Solutions (3 cols on lg) -->
      <div class="lg:col-span-3 space-y-3.5">
        <h2
          class="text-white text-xs font-bold uppercase tracking-wider border-l-2 border-[#38bdf8] pl-2.5"
        >
          บริการและโซลูชัน
        </h2>
        <ul class="space-y-2.5 text-xs sm:text-sm text-slate-300 font-normal">
          {
            wpServices.map((service) => (
              <li>
                <a
                  href={`/services#${service.slug}`}
                  class="hover:text-white hover:translate-x-1 inline-block transition-all"
                >
                  {service.service_meta?.title_th || service.title?.rendered}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href="/tools"
              class="hover:text-white hover:translate-x-1 inline-block transition-all"
            >
              เครื่องมือและเทมเพลตดิจิทัลเพื่อคนทำงาน
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Company & Governance (2 cols on lg) -->
      <div class="lg:col-span-2 space-y-3.5">
        <h2
          class="text-white text-xs font-bold uppercase tracking-wider border-l-2 border-[#38bdf8] pl-2.5"
        >
          เกี่ยวกับองค์กร
        </h2>
        <ul class="space-y-2.5 text-xs sm:text-sm text-slate-300 font-normal">
          <li>
            <a
              href="/team"
              class="hover:text-white hover:translate-x-1 inline-block transition-all"
            >
              บุคลากรและทีมงาน
            </a>
          </li>
          <li>
            <a
              href="/projects"
              class="hover:text-white hover:translate-x-1 inline-block transition-all"
            >
              ผลงานและโครงการจริง
            </a>
          </li>
          <li>
            <a
              href="/blog"
              class="hover:text-white hover:translate-x-1 inline-block transition-all"
            >
              คลังบทความและข่าวสาร
            </a>
          </li>
          <li>
            <a
              href="/cookie-policy"
              class="hover:text-white hover:translate-x-1 inline-block transition-all"
            >
              นโยบายการคุ้มครองข้อมูล (PDPA)
            </a>
          </li>
          <li>
            <a
              href="/contact"
              class="hover:text-white hover:translate-x-1 inline-block transition-all"
            >
              ติดต่อและนัดหมายปรึกษา
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Corporate Contact Details (3 cols on lg) -->
      <div class="lg:col-span-3 space-y-3.5">
        <h2
          class="text-white text-xs font-bold uppercase tracking-wider border-l-2 border-[#38bdf8] pl-2.5"
        >
          ติดต่อ
        </h2>
        <ul class="space-y-3 text-xs sm:text-sm text-slate-300 font-normal">
          <li class="flex items-start gap-2.5">
            <MapPin className="w-4 h-4 text-[#38bdf8] flex-shrink-0 mt-0.5" />
            <span class="leading-relaxed">
              {siteSettings.headquarters_address}
            </span>
          </li>
          <li class="flex items-center gap-2.5">
            <Mail className="w-4 h-4 text-[#38bdf8] flex-shrink-0" />
            <a
              href={`mailto:${siteSettings.contact_email}`}
              class="hover:text-white transition-colors"
            >
              {siteSettings.contact_email}
            </a>
          </li>
          <li class="flex items-center gap-2.5">
            <Phone className="w-4 h-4 text-[#38bdf8] flex-shrink-0" />
            <a
              href={`tel:${siteSettings.contact_phone.replace(/[^0-9]/g, "")}`}
              class="hover:text-white font-bold transition-colors"
            >
              (+66) {siteSettings.contact_phone}
            </a>
          </li>
          <li class="flex items-center gap-2.5 text-xs text-slate-300">
            <Clock className="w-3.5 h-3.5 text-slate-300 flex-shrink-0" />
            <span>เวลาทำการ: {siteSettings.working_hours}</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Corporate Bottom Bar: Copyright & Compliance -->
    <div
      class="pt-8 border-t border-slate-800 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-slate-300"
    >
      <div
        class="flex flex-col sm:flex-row items-center gap-2 sm:gap-4 text-center sm:text-left"
      >
        <p>
          © {currentYear}
          <strong class="text-slate-200"
            >{siteSettings.company_name_th} ({
              siteSettings.company_name_en
            })</strong
          >
          {siteSettings.copyright_text}
        </p>
        <span class="hidden sm:inline text-slate-700">|</span>
        <div class="flex items-center gap-3 font-medium">
          <a href="/cookie-policy" class="hover:text-white transition-colors">
            นโยบายความเป็นส่วนตัวและคุกกี้
          </a>
          <span class="text-slate-700">·</span>
          <button
            type="button"
            id="footer-open-cookie-settings"
            class="hover:text-white transition-colors cursor-pointer text-slate-300 underline underline-offset-2"
          >
            ตั้งค่าคุกกี้
          </button>
        </div>
      </div>
    </div>
  </div>
</footer>

<script>
  function setupFooterCookieTrigger() {
    const btn = document.getElementById("footer-open-cookie-settings");
    if (btn) {
      btn.onclick = () => {
        window.dispatchEvent(new CustomEvent("open-cookie-consent"));
      };
    }
  }

  document.addEventListener("astro:page-load", setupFooterCookieTrigger);
</script>
