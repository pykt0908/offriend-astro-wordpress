---
import type { WPPost } from '../types/wordpress';
import { FileText } from 'lucide-react';

interface Props {
  post: WPPost;
}

const { post } = Astro.props;

// Extract featured image from _embedded
const featuredImage =
  post._embedded?.['wp:featuredmedia']?.[0]?.source_url || null;

// Extract category name
const categoryName =
  post._embedded?.['wp:term']?.[0]?.[0]?.name || 'ทั่วไป';

// Format date
const postDate = new Date(post.date).toLocaleDateString('th-TH', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article class="group glass-panel flex flex-col h-full rounded-2xl overflow-hidden border border-slate-200/80 dark:border-white/10 bg-white dark:bg-[#0c1222] shadow-xs hover:shadow-md transition-all duration-300">
  <!-- Post Thumbnail / Fallback (No category overlay) -->
  <a href={`/blog/${post.slug}`} class="block relative w-full h-48 sm:h-52 overflow-hidden bg-slate-100 dark:bg-[#0c1222]">
    {
      featuredImage ? (
        <img
          src={featuredImage}
          alt={post.title.rendered}
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          loading="lazy"
        />
      ) : (
        <div class="w-full h-full flex flex-col items-center justify-center bg-gradient-to-br from-slate-100 to-sky-50 dark:from-[#0c1427] dark:to-[#122040] p-4 text-center">
          <div class="w-12 h-12 rounded-lg bg-[#162d59]/15 border border-[#162d59]/25 flex items-center justify-center text-[#060c2e] dark:text-[#38bdf8] mb-2">
            <FileText className="w-6 h-6 text-[#060c2e] dark:text-[#38bdf8]" />
          </div>
          <span class="text-xs font-semibold text-slate-700 dark:text-slate-400">Offriend Tech Insights</span>
        </div>
      )
    }
  </a>

  <!-- Content -->
  <div class="p-5 sm:p-6 flex flex-col flex-grow">
    <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-2.5 font-medium">
      <span>{postDate}</span>
      <span>•</span>
      <span>อ่าน 3 นาที</span>
    </div>

    <h3 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white group-hover:text-[#162d59] dark:group-hover:text-[#38bdf8] transition-colors line-clamp-2 leading-snug">
      <a href={`/blog/${post.slug}`} set:html={post.title.rendered} />
    </h3>

    <!-- Bottom: หมวดหมู่ (ย้ายมาไว้ข้างล่าง / ไม่มีผู้โพสและอ่านบทความ) -->
    <div class="pt-4 mt-auto border-t border-slate-100 dark:border-white/10 flex items-center">
      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-[#e8f0f2] dark:bg-[#162d59]/40 text-[#162d59] dark:text-[#38bdf8] border border-[#162d59]/15 dark:border-[#38bdf8]/20">
        {categoryName}
      </span>
    </div>
  </div>
</article>
