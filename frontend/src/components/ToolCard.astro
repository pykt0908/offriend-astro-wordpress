---
import type { WPTool } from '../types/wordpress';
import { imageProps } from '../lib/image';
import { ArrowRight, Download, FileSpreadsheet, Sparkles, CheckCircle2 } from 'lucide-react';

interface Props {
  tool: WPTool;
}

const { tool } = Astro.props;

// Determine image URL from featured_image_url or _embedded media
const featuredImage =
  tool.featured_image_url ||
  tool._embedded?.['wp:featuredmedia']?.[0]?.source_url ||
  '/images/tools/budget-calculator.webp';
const picture = imageProps(
  featuredImage,
  tool._embedded?.['wp:featuredmedia']?.[0],
  { width: 1280, height: 720 },
);

// Format excerpt
const rawExcerpt = tool.excerpt?.rendered || '';
const cleanExcerpt = rawExcerpt.replace(/<[^>]+>/g, '').trim();

// Meta info
const format = tool.tool_meta?.format || 'Template & Tool';
const badge = tool.tool_meta?.badge || 'แนะนำ 2026';
const downloads = tool.tool_meta?.downloads || 'ใช้งานฟรี';
const version = tool.tool_meta?.version || '';
---

<article class="group bg-white dark:bg-[#0c1222] border border-slate-200 dark:border-white/10 rounded-xl overflow-hidden shadow-xs hover:shadow-xl hover:border-[#162d59]/40 dark:hover:border-indigo-300/40 transition-all duration-300 flex flex-col h-full">
  <!-- 16:9 Image Container -->
  <a
    href={`/tools/${tool.slug}`}
    data-astro-prefetch="hover"
    aria-label={tool.title.rendered}
    class="block relative w-full aspect-video overflow-hidden bg-slate-100 dark:bg-slate-900 rounded-t-xl"
  >
    <img
      {...picture}
      alt=""
      transition:name={`tool-image-${tool.slug}`}
      class="w-full h-full object-cover rounded-t-xl transition-transform duration-500 group-hover:scale-105"
      loading="lazy"
      decoding="async"
    />
    <!-- Gradient Overlay for Contrast -->
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

    <!-- Badge Tag -->
    {badge && (
      <div class="absolute top-3 left-3">
        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-[11px] font-bold bg-white/95 dark:bg-[#070b14]/90 backdrop-blur-md text-[#0a192f] dark:text-[#93c5fd] border border-slate-200/80 dark:border-white/10 shadow-xs">
          <Sparkles className="w-3 h-3 text-[#162d59]" />
          {badge}
        </span>
      </div>
    )}

    <!-- Format Tag -->
    <div class="absolute bottom-3 right-3 opacity-90 group-hover:opacity-100 transition-opacity">
      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[10px] font-semibold bg-slate-900/80 backdrop-blur-md text-slate-200 border border-white/10">
        {format}
      </span>
    </div>
  </a>

  <!-- Content -->
  <div class="p-5 flex flex-col flex-1">
    <!-- Title (2-line clamp) -->
    <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white group-hover:text-[#060c2e] dark:group-hover:text-[#38bdf8] transition-colors line-clamp-2 leading-snug mb-2 font-display">
      <a href={`/tools/${tool.slug}`} data-astro-prefetch="hover">
        {tool.title.rendered}
      </a>
    </h3>

    <!-- Excerpt (2-line clamp) -->
    <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 font-content line-clamp-2 leading-relaxed mb-4 flex-1">
      {cleanExcerpt}
    </p>

    <!-- Meta specs row -->
    <div class="flex items-center gap-3 text-xs text-slate-600 dark:text-slate-400 pt-3 border-t border-slate-100 dark:border-white/5 mb-4">
      <div class="flex items-center gap-1.5 truncate">
        <FileSpreadsheet className="w-3.5 h-3.5 text-[#162d59] shrink-0" />
        <span class="truncate">{format}</span>
      </div>
      <span class="text-slate-300 dark:text-slate-700">•</span>
      <div class="flex items-center gap-1.5 shrink-0">
        <Download className="w-3.5 h-3.5 text-emerald-500 shrink-0" />
        <span>{downloads}</span>
      </div>
    </div>

    <!-- Bottom Row: Price/Free on Left, CTA on Right -->
    <div class="flex items-center justify-between pt-2">
      <div class="flex items-baseline gap-1.5">
        <span class="text-base sm:text-lg font-extrabold text-emerald-700 dark:text-emerald-400 font-display">
          ฟรี
        </span>
        <span class="text-xs text-slate-600 dark:text-slate-400 font-normal">
          ไม่มีค่าใช้จ่าย
        </span>
      </div>

      <a
        href={`/tools/${tool.slug}`}
        data-astro-prefetch="hover"
        class="inline-flex items-center gap-1 text-xs sm:text-sm font-bold text-[#060c2e] dark:text-[#38bdf8] hover:text-[#0a192f] dark:hover:text-[#93c5fd] transition-colors group/link"
      >
        <span>ดูรายละเอียด</span>
        <ArrowRight className="w-3.5 h-3.5 transition-transform group-hover/link:translate-x-0.5" />
      </a>
    </div>
  </div>
</article>
